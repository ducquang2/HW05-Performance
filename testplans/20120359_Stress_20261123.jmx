<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="20120359_Stress_20261123 - W2 Browse &amp; Coupon">
  <stringProp name="TestPlan.comments">Stress W2: 10 bậc, mỗi bậc +step_users VU (mặc định 50) sau mỗi step_secs giây (mặc định 60), trần 500 VU. Think-time think_min + ngẫu nhiên think_range ms (mặc định 0-100 ms). Chạy thử: -Jstep_users=10 -Jstep_secs=10</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</TestPlan>
<hashTree>
<Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
